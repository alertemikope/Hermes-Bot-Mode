ARG HERMES_BASE=hermes-agent:local
FROM ${HERMES_BASE}

USER root
ARG CUA_DRIVER_VERSION=0.19.3
ARG CUA_DRIVER_URL=https://files.pythonhosted.org/packages/88/26/1b372765b192a2f4f7ee7e1474d1e39be9ab3bd637765f632e30e7ee6e18/cua_driver-0.19.3-py3-none-manylinux_2_31_x86_64.whl
ARG CUA_DRIVER_SHA256=3f327a444f5b666037dee5e7c15c98990abbfb4fe83669ef708cb34c2cafef14
ARG GOOGLE_WORKSPACE_CLI_VERSION=0.22.5
ARG PENNYLANE_MCP_VERSION=0.1.0
ARG PENNYLANE_MCP_URL=https://github.com/FGRibreau/mcp-pennylane/releases/download/v0.1.0/mcp-pennylane-x86_64-unknown-linux-gnu.tar.gz
ARG PENNYLANE_MCP_SHA256=69d5b25f2287604e5e4804ad40406d2d97d49c78954d65676d75d5ac29c02cb8
RUN wheel="/tmp/cua_driver-${CUA_DRIVER_VERSION}-py3-none-manylinux_2_31_x86_64.whl" \
    && curl -fsSL "$CUA_DRIVER_URL" -o "$wheel" \
    && echo "$CUA_DRIVER_SHA256  $wheel" | sha256sum -c - \
    && python3 -m venv /opt/cua \
    && /opt/cua/bin/pip install --no-cache-dir --no-deps "$wheel" \
    && driver_bin="$(find /opt/cua/lib -path '*/cua_driver/bin/cua-driver' -type f -print -quit)" \
    && install -m 0755 "$driver_bin" /usr/local/bin/cua-driver \
    && test "$(cua-driver --version)" = "cua-driver ${CUA_DRIVER_VERSION}" \
    && rm -f "$wheel" \
    && npm install --global --omit=dev --ignore-scripts "@googleworkspace/cli@${GOOGLE_WORKSPACE_CLI_VERSION}" \
    && node "$(npm root --global)/@googleworkspace/cli/install.js" \
    && gws --version | grep -qx "gws ${GOOGLE_WORKSPACE_CLI_VERSION}" \
    && pennylane_archive="/tmp/mcp-pennylane-${PENNYLANE_MCP_VERSION}.tar.gz" \
    && curl -fsSL "$PENNYLANE_MCP_URL" -o "$pennylane_archive" \
    && echo "$PENNYLANE_MCP_SHA256  $pennylane_archive" | sha256sum -c - \
    && tar -xzf "$pennylane_archive" -C /usr/local/bin mcp-pennylane \
    && chmod 0755 /usr/local/bin/mcp-pennylane \
    && test "$(mcp-pennylane --version)" = "mcp-pennylane ${PENNYLANE_MCP_VERSION}" \
    && rm -f "$pennylane_archive"
COPY --chmod=0755 hermes-cua-wrapper /usr/local/bin/hermes-cua-wrapper
ENV HERMES_CUA_DRIVER_CMD=/usr/local/bin/hermes-cua-wrapper
